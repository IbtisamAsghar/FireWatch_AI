# Template only. Copy to .env locally; never commit real credentials.
# Native setup generates required local secrets. Missing/placeholder DB and admin secrets fail startup.
# FIRMS is optional until ingestion; chain credentials are required only if CHAIN_ENABLED=true.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://firewatch:REPLACE_ME@localhost:5432/firewatch
POSTGRES_DB=firewatch
POSTGRES_USER=firewatch
POSTGRES_PASSWORD=REPLACE_ME
FIRMS_MAP_KEY=REPLACE_ME
ADMIN_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
CORS_ORIGINS=[]
REGIONS_CONFIG=configs/regions.yaml
RAW_DATA_DIR=data/raw
MODEL_DIR=models
ACTIVE_SCORER=baseline-v1
REFRESH_INTERVAL_MINUTES=15
WEATHER_CACHE_GRID_DEGREES=0.1
WEATHER_MAX_AGE_HOURS=3
CLUSTER_RADIUS_KM=2
SNAPSHOT_LOOKBACK_HOURS=6
LABEL_HORIZON_HOURS=24
FEATURE_SCHEMA_VERSION=features-v1
EVIDENCE_SCHEMA_VERSION=evidence-v1
CHAIN_ENABLED=false
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
ALERT_REGISTRY_ADDRESS=
CHAIN_PRIVATE_KEY=
PUBLIC_API_HOSTNAME=

# Per-process pool bounds and database timeouts.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000

# Prototype read APIs expose sanitized research results; false requires operator auth.
PUBLIC_READS_ENABLED=true
