{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        },
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "DateInterval": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "DateInterval",
      "type": "object"
    },
    "Product": {
      "enum": [
        "VIIRS_NOAA20_NRT",
        "VIIRS_NOAA21_NRT",
        "VIIRS_NOAA20_SP",
        "VIIRS_NOAA21_SP"
      ],
      "title": "Product",
      "type": "string"
    },
    "Sensor": {
      "enum": [
        "NOAA-20",
        "NOAA-21"
      ],
      "title": "Sensor",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "firms-archive-manifest-v1",
      "default": "firms-archive-manifest-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "trusted_local_input": {
      "const": true,
      "title": "Trusted Local Input",
      "type": "boolean"
    },
    "source_url": {
      "maxLength": 1000,
      "title": "Source Url",
      "type": "string"
    },
    "source_kind": {
      "default": "archive_portal",
      "enum": [
        "archive_portal",
        "area_api_sample"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "archive_request_id": {
      "anyOf": [
        {
          "pattern": "^[0-9]{1,20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Request Id"
    },
    "product": {
      "$ref": "#/$defs/Product"
    },
    "sensor": {
      "$ref": "#/$defs/Sensor"
    },
    "interval": {
      "$ref": "#/$defs/DateInterval"
    },
    "region": {
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Region",
      "type": "string"
    },
    "bbox": {
      "$ref": "#/$defs/BoundingBox"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "attribution_url": {
      "maxLength": 1000,
      "title": "Attribution Url",
      "type": "string"
    },
    "earliest_feature_cutoff": {
      "format": "date-time",
      "title": "Earliest Feature Cutoff",
      "type": "string"
    },
    "last_label_cutoff": {
      "format": "date-time",
      "title": "Last Label Cutoff",
      "type": "string"
    },
    "cutoff_purpose": {
      "default": "proposed",
      "enum": [
        "proposed",
        "approved"
      ],
      "title": "Cutoff Purpose",
      "type": "string"
    },
    "covered_intervals": {
      "items": {
        "$ref": "#/$defs/DateInterval"
      },
      "maxItems": 1000,
      "title": "Covered Intervals",
      "type": "array"
    },
    "expected_active_intervals": {
      "items": {
        "$ref": "#/$defs/DateInterval"
      },
      "maxItems": 1000,
      "title": "Expected Active Intervals",
      "type": "array"
    },
    "confirmed_empty_intervals": {
      "items": {
        "$ref": "#/$defs/DateInterval"
      },
      "maxItems": 1000,
      "title": "Confirmed Empty Intervals",
      "type": "array"
    }
  },
  "required": [
    "trusted_local_input",
    "source_url",
    "product",
    "sensor",
    "interval",
    "region",
    "bbox",
    "sha256",
    "retrieved_at",
    "attribution_url",
    "earliest_feature_cutoff",
    "last_label_cutoff"
  ],
  "title": "ArchiveManifest",
  "type": "object"
}
