* text=auto
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
.env.example text eol=lf
.env.compose.example text eol=lf
.gitattributes text eol=lf
*.lock text eol=lf
*.in text eol=lf
*.sol text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Published evidence/model hashes bind exact bytes, including line endings.
data/** -text -whitespace
models/** -text -whitespace
artifacts/** -text -whitespace
dist/** -text -whitespace
output/** -text -whitespace
.local/readiness/** -text -whitespace
.local/model-training/*.log -text -whitespace
