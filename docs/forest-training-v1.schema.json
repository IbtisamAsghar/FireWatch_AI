      "title": "Schema Version",
      "type": "string"
    },
    "tree_counts": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Tree Counts",
      "type": "array"
    },
    "depths": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Depths",
      "type": "array"
    },
    "leaf_sizes": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Leaf Sizes",
      "type": "array"
    },
    "class_weights": {
      "items": {
        "anyOf": [
          {
            "const": "balanced",
            "type": "string"
          },
          {
            "type": "null"
