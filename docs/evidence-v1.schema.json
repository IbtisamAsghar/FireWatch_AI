{
  "$defs": {
    "AssetPin": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256"
      ],
      "title": "AssetPin",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "west": {
          "title": "West",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        },
        "south": {
          "title": "South",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        },
        "east": {
          "title": "East",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        },
        "north": {
          "title": "North",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ClimateBaseline": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "contracts-v1",
          "default": "contracts-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "cell_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Cell Key",
          "type": "string"
        },
        "latitude": {
          "title": "Latitude",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        },
        "longitude": {
          "title": "Longitude",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        },
        "source": {
          "$ref": "#/$defs/Provider",
          "default": "nasa_power"
        },
        "reference_start_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Reference Start Year",
          "type": "integer"
        },
        "reference_end_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Reference End Year",
          "type": "integer"
        },
        "month": {
          "maximum": 12,
          "minimum": 1,
          "title": "Month",
          "type": "integer"
        },
        "temperature_mean_c": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Mean C"
        },
        "precipitation_mean_mm": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precipitation Mean Mm"
        },
        "sample_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Sample Counts",
          "type": "object"
        },
        "statistics": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Statistics",
          "type": "object"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "cell_key",
        "latitude",
        "longitude",
        "reference_start_year",
        "reference_end_year",
        "month",
        "sample_counts",
        "statistics",
        "version",
        "asset_id"
      ],
      "title": "ClimateBaseline",
      "type": "object"
    },
    "ClusterSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "contracts-v1",
          "default": "contracts-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RunMode"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "feature_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Feature Version",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "latitude": {
          "title": "Latitude",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        },
        "longitude": {
          "title": "Longitude",
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
        },
        "member_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Ids",
          "type": "array"
        },
        "frp_max_mw": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frp Max Mw"
        },
        "frp_sum_mw": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frp Sum Mw"
        },
        "latest_detection_at": {
          "format": "date-time",
          "title": "Latest Detection At",
          "type": "string"
        },
        "algorithm_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Algorithm Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "mode",
        "as_of",
        "feature_version",
        "snapshot_id",
        "latitude",
        "longitude",
        "member_ids",
        "latest_detection_at",
        "algorithm_version"
      ],
      "title": "ClusterSnapshot",
      "type": "object"
    },
