      "type": "integer"
    },
    "n_jobs": {
      "const": 1,
      "default": 1,
      "title": "N Jobs",
      "type": "integer"
    },
    "max_features": {
      "const": "sqrt",
      "default": "sqrt",
      "title": "Max Features",
      "type": "string"
    },
    "calibration_purge_hours": {
      "default": 48,
      "maximum": 168,
      "minimum": 48,
      "title": "Calibration Purge Hours",
      "type": "integer"
    },
    "min_calibration_events": {
      "default": 4,
      "maximum": 100,
      "minimum": 4,
      "title": "Min Calibration Events",
      "type": "integer"
    },
    "min_calibration_rows_per_class": {
      "default": 10,
      "maximum": 1000,
      "minimum": 10,
      "title": "Min Calibration Rows Per Class",
      "type": "integer"
    },
    "min_audit_events": {
      "default": 4,
      "maximum": 100,
      "minimum": 4,
      "title": "Min Audit Events",
      "type": "integer"
    },
    "min_audit_rows_per_class": {
      "default": 10,
      "maximum": 1000,
